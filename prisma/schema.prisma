// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refreshToken       String?  @db.Text @map("refresh_token")
  accessToken        String?  @db.Text @map("access_token")
  expiresAt          Int?     @map("expires_at")
  tokenType          String?  @map("token_type")
  scope              String?
  idToken            String?  @db.Text @map("id_token")
  sessionState       String?  @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserType {
  User
  Admin
  Super
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  hashedPassword        String?   @map("hashed_password")
  email                 String?   @unique
  emailVerified         DateTime? @map("email_verified")
  image                 String?
  accounts              Account[]
  sessions              Session[]
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  userType              UserType  @default(User) @map("user_type")

  favoriteIds           String[]  @map("favorite_ids")

  products              Product[]
  tradeLists            TradeList[]
  favorites             Favorite[]
  investmentAccounts    InvestmentAccount[]
  profit                Profit[]
  notices               Notice[]
}

model InvestmentAccount {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  name                 String
  totalProfitAmount    Float    @map("total_profit_amount")
  totalProfitRate      Float    @map("total_profit_rate")
  riskTolerance        String   @map("risk_tolerance")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user                 User     @relation(fields: [userId], references: [id])
}

model Profit {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  company              String
  category             String
  profitAmount         Float    @map("profit_amount")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user                 User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Status {
  ACTIVE
  DELISTED
}

model Stock {
  id            Int       @id @default(autoincrement())
  isinCode      String    @unique @map("isin_code")       // 표준코드
  ticker        String?   @unique                         // 단축코드
  name          String    @unique @map("name")            // 한글 종목명
  shortName     String    @unique @map("short_name")      // 한글 종목약명
  englishName   String?   @unique @map("english_name")    // 영문 종목
  listingDate   DateTime? @map("listing_date")            // 상장일
  marketType    String?   @map("market_type")             // 시장구분
  securityType  String    @map("security_type")           // 증권구분
  sector        String?                                   // 소속부
  stockType     String    @map("stock_type")              // 주식종류
  parValue      Int?      @map("par_value")               // 액면가
  listedShares  BigInt?  @map("listed_shares")           // 상장주식수
  status        Status    @default(ACTIVE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
}

model Product {
  id                    String   @id @default(cuid())
  category              String
  symbol                String?
  company               String
  currency              String?
  quantity              Float
  price                 Float
  userId                String   @map("user_id")
  theme1                String?
  theme2                String?
  reason                String?
  orderType             String   @default("BUY") @map("order_type")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  Favorites             Favorite[]

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradeList {
  id                    String   @id @default(cuid())
  category              String
  symbol                String?
  company               String
  currency              String?
  totalQuantity         Float    @map("total_quantity")
  totalPrice            Float    @map("total_price")
  avgPrice              Float    @map("avg_price")
  desiredSellingPrice   Float?   @map("desired_selling_price")
  userId                String   @map("user_id")
  theme1                String?
  theme2                String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id                    String   @id @default(cuid())
  symbol                String
  company               String
  currency              String
  price                 Int?
  desiredSellingPrice   Int?     @map("desired_selling_price")
  userId                String   @map("user_id")
  productId             String   @map("product_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Notice {
  id                    String   @id @default(cuid())
  title                 String
  content               String   @db.Text
  isImportant           Boolean  @default(false) @map("is_important")
  isPublished           Boolean  @default(true)  @map("is_published")
  authorId              String   @map("author_id")
  viewCount             Int      @default(0)     @map("view_count")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt      @map("updated_at")

  author                User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
